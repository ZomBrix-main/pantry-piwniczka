{
    "name": "kacper/symfony-first",
    "description": "Testowy projekt",
    "type": "project",
    "authors": [
        {
            "name": "Kacper",
            "email": "kuczawskikontakt@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require": {
        "symfony/http-foundation": "*",
        "symfony/routing": "*",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/yaml": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/form": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/security-csrf": "^8.1",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "symfony/twig-bundle": "^8.1",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/twig": "^2.12|^3.0"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "require-dev": {
        "symfony/maker-bundle": "^1.67",
        "phpunit/phpunit": "^13.3",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1"
    }
}
