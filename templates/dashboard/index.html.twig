{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mt-5">
        <h1 class="pantry-title text-center">Witaj w Piwniczce! 🍓</h1>

        <div class="row">
            <!-- Zwykły kafelek -->
            <div class="col-md-4">
                <div class="blog-card">
                    <h4>Stan Zapasów</h4>
                    <h1 class="display-4">{{ jars_count }}</h1>
                    <p class="text-muted">gotowych przetworów czeka na zjedzenie</p>
                </div>
            </div>

            <!-- Kafelek z agregacją -->
            <div class="col-12 mb-4">
                <div class="blog-card green">
                    <h4>Król Spiżarni 👑</h4>
                    <h3>{{ popular_name }}</h3>
                    <p>Mamy aż <strong>{{ popular_amount }}</strong> słoików tego rodzaju!</p>
                </div>
            </div>

            <!-- 5 najnowszych (Lista) -->
            <div class="col-md-4">
                <div class="blog-card purple">
                    <h4>Świeże dostawy</h4>
                    <ul class="list-group list-group-flush">
                        {% for jar in latest_jars %}
                            <li class="list-group-item">{{ jar.content }} <small class="text-muted">({{ jar.createdAt|date('Y-m-d') }})</small></li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>

        <div class="custom-carousel-wrapper">
            <button class="carousel-btn prev-btn" onclick="moveSlide(-1)">&#10094;</button>
            <div class="carousel-viewport">
                <div class="carousel-track" id="logsTrack">

                    {% for log in latest_logs %}
                        <div class="carousel-slide">
                            <div class="log-content">
                                <span class="log-date">{{ log.createdAt|date('d.m.Y H:i') }}</span>
                                <h5 class="log-type">Zdarzenie: {{ log.actionType|upper }}</h5>
                                <p class="log-desc">{{ log.description }}</p>
                            </div>
                        </div>
                    {% else %}
                        <div class="carousel-slide"><p>Brak logów w systemie.</p></div>
                    {% endfor %}

                </div>
            </div>
            <button class="carousel-btn next-btn" onclick="moveSlide(1)">&#10095;</button>
        </div>

        <div style="display: flex; gap: 20px; margin-top: 30px;">
            <!-- Panel: Aktywne przetwory -->
            <div style="border: 2px solid #333; padding: 20px; border-radius: 8px;">
                <h3>Zmagazynowane przetwory</h3>
                <p>Ilość na stanie: <strong>{{ jars_count }}</strong></p>
                <a href="{{ path('app_jar_crud_index') }}">Przejdź do zarządzania słoikami &raquo;</a>
            </div>
            <!-- Panel: Puste Słoiki -->
            <div style="border: 2px solid #333; padding: 20px; border-radius: 8px;">
                <h3>Puste słoiki do wykorzystania</h3>
                <ul>
                    {% for stat in empty_stats %}
                        <li>{{ stat.type }}: <strong>{{ stat.quantity }}</strong></li>
                    {% else %}
                        <li>Brak dodanych statystyk</li>
                    {% endfor %}
                </ul>
                <a href="{{ path('app_empty_jar_stat_crud_index') }}">Zarządzaj rezerwą &raquo;</a>
            </div>
            <!-- Panel: Audyt i Logi -->
            <div style="border: 2px solid #333; padding: 20px; border-radius: 8px;">
                <h3>Dziennik Zdarzeń</h3>
                <p>Zarządzaj wpisami z audytu i awariami.</p>
                <a href="{{ path('app_audit_log_crud_index') }}">Zobacz pełną historię &raquo;</a>
            </div>
        </div>
    </div>

    <script src = "/js/carousel.js"></script>
{% endblock %}
