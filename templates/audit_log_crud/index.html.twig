{% extends 'base.html.twig' %}

{% block title %}Historia Zdarzeń{% endblock %}

{% block body %}
    <h1>Historia Zdarzeń</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Opis</th>
                <th>Utworzono</th>
                <th>Akcja</th>
                <th>Opcje</th>
            </tr>
        </thead>
        <tbody>
        {% for audit_log in audit_logs %}
            <tr>
                <td>{{ audit_log.id }}</td>
                <td>{{ audit_log.description }}</td>
                <td>{{ audit_log.createdAt ? audit_log.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ audit_log.actionType }}</td>
                <td>
                    <a href="{{ path('app_audit_log_crud_show', {'id': audit_log.id}) }}">Pokaż</a>
                    <a href="{{ path('app_audit_log_crud_edit', {'id': audit_log.id}) }}">Edytuj</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Brak wpisów w Historii Zdarzeń</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_audit_log_crud_new') }}" class="btn btn-primary">Dodaj wpis</a>
    <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">Powrót na Stronę Główną</a>
{% endblock %}
